from __future__ import annotations

import json
from typing import Any

from app.data.dataProvider import DataProvider
from app.services.job_handlers import BaseJobHandler, JobExecutionContext
from app.services.runtimes import RuntimeFailure
from app.services.planningBatchTaskExecutor import PlanningBatchTaskExecutor


class BatchGenerationJobHandler(BaseJobHandler):
    async def run(self, context: JobExecutionContext) -> None:
        repo = DataProvider(context.db).batch_generation
        plan_id = str(context.payload.get("plan_id") or "")
        task_key = str(context.payload.get("task_key") or "")
        if not plan_id or not task_key:
            raise RuntimeFailure("Batch generation job is missing plan_id/task_key")

        task = repo.task(plan_id, task_key)
        if not task:
            raise RuntimeFailure(f"Generation task no longer exists: {task_key}")
        if task.get("active_job_id") not in {None, context.job_id}:
            context.db.update_job(context.job_id, "cancelled", error="Generation task was superseded")
            return

        repo.bind_job(plan_id, task_key, context.job_id, "running")
        kind = str(task["generator_kind"])
        if kind == "text":
            await self._run_text(context, repo, plan_id, task)
        elif kind == "deterministic":
            await self._run_deterministic(context, repo, plan_id, task)
        elif kind == "image":
            await self._delegate_image(context, repo, plan_id, task)
        else:
            raise RuntimeFailure(f"Unsupported batch generator kind: {kind}")

    async def _run_text(self, context, repo, plan_id, task) -> None:
        prompt = dict(task.get("prompt") or {})
        settings = dict(task.get("settings") or {})
        if bool(settings.get("planning_bridge")):
            result = await PlanningBatchTaskExecutor().generate(
                context,
                task,
            )
            if result.get("invalid_structured_output"):
                repo.finish_task(
                    plan_id,
                    task["task_key"],
                    context.job_id,
                    status="failed",
                    result=result,
                    error=str(result.get("validation_error") or "Invalid structured planning output"),
                )
                context.db.update_job(
                    context.job_id,
                    "failed",
                    result={
                        "plan_id": plan_id,
                        "task_key": task["task_key"],
                        "result": result,
                    },
                    error=str(result.get("validation_error") or "Invalid structured planning output"),
                )
                return

            repo.finish_task(
                plan_id,
                task["task_key"],
                context.job_id,
                status="generated",
                result=result,
            )
            context.db.update_job(
                context.job_id,
                "completed",
                result={
                    "plan_id": plan_id,
                    "task_key": task["task_key"],
                    "result": result,
                },
            )
            return

        messages = prompt.get("messages")
        if not isinstance(messages, list) or not messages:
            instruction = str(prompt.get("instruction") or prompt.get("prompt") or "").strip()
            if not instruction:
                raise RuntimeFailure(f"Text task {task['task_key']} has no prompt")
            messages = [{"role": "user", "content": instruction}]

        runtime_mode = str(settings.get("runtime_mode") or "normal")
        if runtime_mode not in {"normal", "planning"}:
            runtime_mode = "normal"
        max_tokens = int(settings.get("max_tokens") or 800)

        chunks: list[str] = []
        await context.state("generating_story", f"Generating {task.get('label') or task['task_key']}")
        async with context.ai.text_session(
            runtime_mode,
            reason=f"Batch generation task {task['task_key']}",
        ) as llama:
            async for chunk in llama.chat_stream(
                messages,
                max_tokens=max_tokens,
                cancel_event=context.cancel_event,
            ):
                if context.cancel_event.is_set():
                    raise RuntimeError("Batch generation task was cancelled")
                chunks.append(str(chunk))
                context.db.update_job_partial_output(context.job_id, "".join(chunks))

        content = "".join(chunks).strip()
        result: dict[str, Any] = {"content": content}
        if bool(settings.get("parse_json")):
            try:
                result["json"] = json.loads(content)
            except json.JSONDecodeError as exc:
                raise RuntimeFailure(f"Generated task output was not valid JSON: {exc}") from exc

        repo.finish_task(plan_id, task["task_key"], context.job_id, status="generated", result=result)
        context.db.update_job(
            context.job_id,
            "completed",
            result={"plan_id": plan_id, "task_key": task["task_key"], "result": result},
        )
        await self._publish(context, plan_id, task["task_key"], "generated", result)

    async def _run_deterministic(self, context, repo, plan_id, task) -> None:
        prompt = dict(task.get("prompt") or {})
        value = prompt.get("value", prompt.get("result", prompt))
        result = {"value": value}
        repo.finish_task(plan_id, task["task_key"], context.job_id, status="generated", result=result)
        context.db.update_job(
            context.job_id,
            "completed",
            result={"plan_id": plan_id, "task_key": task["task_key"], "result": result},
        )
        await self._publish(context, plan_id, task["task_key"], "generated", result)

    async def _delegate_image(self, context, repo, plan_id, task) -> None:
        prompt = dict(task.get("prompt") or {})
        settings = dict(task.get("settings") or {})
        preset_id = settings.get("workflow_preset_id") or prompt.get("workflow_preset_id")
        if not preset_id:
            raise RuntimeFailure(f"Image task {task['task_key']} has no workflow_preset_id")

        values = dict(prompt.get("values") or {})
        if not values:
            values = {
                key: value
                for key, value in prompt.items()
                if key not in {"workflow_preset_id", "messages"}
            }

        image_job = context.db.create_job(
            context.project_id,
            "image",
            {
                "preset_id": preset_id,
                "values": values,
                "batch_generation_plan_id": plan_id,
                "batch_generation_task_key": task["task_key"],
            },
            context.job.get("requested_by_user_id"),
            context.job.get("requester_name_snapshot"),
        )
        repo.bind_job(plan_id, task["task_key"], image_job["id"], "queued")
        context.db.update_job(
            context.job_id,
            "completed",
            result={
                "plan_id": plan_id,
                "task_key": task["task_key"],
                "delegated_job_id": image_job["id"],
            },
        )
        await context.enqueue(image_job["id"])
        await self._publish(
            context,
            plan_id,
            task["task_key"],
            "queued",
            {"delegated_job_id": image_job["id"]},
        )

    async def cancel(self, context: JobExecutionContext) -> None:
        plan_id = context.payload.get("plan_id")
        task_key = context.payload.get("task_key")
        if plan_id and task_key:
            DataProvider(context.db).batch_generation.finish_task(
                str(plan_id), str(task_key), context.job_id,
                status="cancelled", error="Batch generation task was cancelled",
            )

    async def failed(self, context: JobExecutionContext, error: BaseException) -> None:
        plan_id = context.payload.get("plan_id")
        task_key = context.payload.get("task_key")
        if plan_id and task_key:
            DataProvider(context.db).batch_generation.finish_task(
                str(plan_id), str(task_key), context.job_id,
                status="failed", error=str(error) or type(error).__name__,
            )

    async def _publish(self, context, plan_id, task_key, status, result) -> None:
        await context.events.publish(
            "batch_generation",
            {
                "project_id": context.project_id,
                "plan_id": plan_id,
                "task_key": task_key,
                "status": status,
                "result": result,
            },
        )
